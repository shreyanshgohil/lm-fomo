{
  "name": "shopify-app-template-node",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "debug": "node --import ./load-env.js --inspect-brk index.js",
    "dev": "cross-env NODE_ENV=development nodemon --exec \"node --import ./load-env.js\" index.js --ignore ./frontend",
    "serve": "cross-env NODE_ENV=production node --import ./load-env.js index.js",
    "test": "node --test services/widget-settings.test.js",
    "production": "cross-env NODE_ENV=production BACKEND_PORT=6500 pm2 start npm --name \"lm-fomo\" -- run serve"
  },
  "type": "module",
  "engines": {
    "node": ">=16.13.0"
  },
  "dependencies": {
    "@shopify/shopify-api": "^12.0.0",
    "@shopify/shopify-app-express": "^6.0.5",
    "@shopify/shopify-app-session-storage-mongodb": "^5.0.5",
    "agenda": "^5.0.0",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "mongodb": "^6.16.0",
    "serve-static": "^1.14.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.15",
    "prettier": "^2.6.2",
    "pretty-quick": "^3.1.3"
  }
}
